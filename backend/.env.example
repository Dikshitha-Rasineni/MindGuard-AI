# Copy to backend/.env for local runs. On Vercel, set these under Project -> Settings -> Environment Variables.
# MongoDB Atlas (free M0 cluster) connection string, with the database name before the "?":
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mindguard?retryWrites=true&w=majority
# Any long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string
